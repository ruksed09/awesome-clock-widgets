<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal install-time permission: lets the user apply a theme background as the lock-screen wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Updates: read the latest release from GitHub and download its APK. Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates: hand a verified APK to Android's installer (the user still confirms every install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Countdown widgets: reset their timers after a restart (the timer counts from boot time). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility for the app drawer: launchable activities only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VersityLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Home screen role. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also appears in other launchers so it can be opened and set as default. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Home-screen widgets. TextClock and AnalogClock keep time, so only the month view uses an
          alarm (once, after midnight). The first two class names date from 0.2 and are kept so placed
          widgets survive updates.
        -->
        <receiver
            android:name=".widget.CelestialTimeWidget"
            android:exported="false"
            android:label="@string/widget_digital_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_celestial_time_info" />
        </receiver>
        <receiver
            android:name=".widget.CelestialTimeDateWidget"
            android:exported="false"
            android:label="@string/widget_clock_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_celestial_time_date_info" />
        </receiver>
        <receiver
            android:name=".widget.AnalogueClockWidget"
            android:exported="false"
            android:label="@string/widget_analogue_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analogue_info" />
        </receiver>
        <receiver
            android:name=".widget.DateWidget"
            android:exported="false"
            android:label="@string/widget_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The month view is redrawn when the clock, time zone or language changes. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_info" />
        </receiver>

        <!-- The collection: countdown, radial launcher, app shortcut and badge. -->
        <receiver
            android:name=".widget.CountdownWidget"
            android:exported="false"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Countdown timers count from the clock's boot time, so they are reset after a restart or clock change. -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <receiver
            android:name=".widget.RadialLauncherWidget"
            android:exported="false"
            android:label="@string/widget_launcher_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_launcher_info" />
        </receiver>
        <receiver
            android:name=".widget.AppShortcutWidget"
            android:exported="false"
            android:label="@string/widget_shortcut_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shortcut_info" />
        </receiver>
        <receiver
            android:name=".widget.BadgeWidget"
            android:exported="false"
            android:label="@string/widget_badge_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_badge_info" />
        </receiver>

        <!-- Shares a downloaded, verified update APK with Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Confirms a widget pinned from the studio and hands it the look the user designed. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- The widget studio, opened by home screens when a widget is placed or re-edited. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_studio_title"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
