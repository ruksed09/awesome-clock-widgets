<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal install-time permission: lets the user apply a theme background as the lock-screen wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Android 11+ package visibility for the app drawer: launchable activities only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VersityLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Home screen role. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also appears in other launchers so it can be opened and set as default. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen clock widgets. TextClock keeps time, so there are no update alarms. -->
        <receiver
            android:name=".widget.CelestialTimeWidget"
            android:exported="false"
            android:label="@string/widget_celestial_time_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_celestial_time_info" />
        </receiver>
        <receiver
            android:name=".widget.CelestialTimeDateWidget"
            android:exported="false"
            android:label="@string/widget_celestial_time_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_celestial_time_date_info" />
        </receiver>
    </application>
</manifest>
