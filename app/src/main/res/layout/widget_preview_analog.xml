<?xml version="1.0" encoding="utf-8"?>
<!-- Analogue clock preview: index dial and classic hands on a dark face. Shown in the phone's widget picker. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_face" />

    <AnalogClock
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:dial="@drawable/wa_dial_index"
        android:hand_hour="@drawable/wa_hand_classic_hour_light"
        android:hand_minute="@drawable/wa_hand_classic_minute_light" />
</FrameLayout>
