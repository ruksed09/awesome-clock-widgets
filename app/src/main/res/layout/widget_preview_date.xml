<?xml version="1.0" encoding="utf-8"?>
<!-- Date preview: weekday, day number and month on a glass card. Shown in the phone's widget picker and until Versity draws the widget's own look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_panel"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">
    <TextClock
        android:id="@+id/w_kicker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/inter"
        android:fontFeatureSettings="lnum"
        android:fontVariationSettings="'wght' 500"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.16"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF6B5A" />
    <TextClock
        android:id="@+id/w_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:autoSizeMaxTextSize="200sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/inter"
        android:fontFeatureSettings="lnum"
        android:fontVariationSettings="'wght' 200"
        android:format12Hour="d"
        android:format24Hour="d"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="#FFFFFF" />
    <TextClock
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:autoSizeMaxTextSize="30sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/inter"
        android:fontFeatureSettings="lnum"
        android:fontVariationSettings="'wght' 400"
        android:format12Hour="MMMM"
        android:format24Hour="MMMM"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.01"
        android:maxLines="1"
        android:textColor="#CCFFFFFF" />
</LinearLayout>
