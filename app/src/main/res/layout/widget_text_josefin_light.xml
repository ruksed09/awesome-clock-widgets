<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextClock
            android:id="@+id/w_kicker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.62"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 400"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 400"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.0"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:autoSizeMaxTextSize="220sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 300"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_hour"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.3"
            android:autoSizeMaxTextSize="220sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 300"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_minute"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.3"
            android:autoSizeMaxTextSize="220sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 300"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_day"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.6"
            android:autoSizeMaxTextSize="220sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 300"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/w_ornament_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_ornament"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <TextClock
            android:id="@+id/w_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 400"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/w_date_caps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/josefin_sans"
            android:fontFeatureSettings="lnum, tnum"
            android:fontVariationSettings="'wght' 400"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
