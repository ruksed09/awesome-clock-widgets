<?xml version="1.0" encoding="utf-8"?>
<!-- Clock and date preview: serif time, starlit line and the date. Shown in the phone's widget picker and until Versity draws the widget's own look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">
    <TextClock
        android:id="@+id/w_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:autoSizeMaxTextSize="200sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/cormorant"
        android:fontFeatureSettings="lnum"
        android:fontVariationSettings="'wght' 300"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:textColor="#DCEBFA" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wo_star"
        android:tint="#DCEBFA" />
    <TextClock
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/cormorant"
        android:fontFeatureSettings="lnum"
        android:fontVariationSettings="'wght' 500"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#CCDCEBFA" />
</LinearLayout>
